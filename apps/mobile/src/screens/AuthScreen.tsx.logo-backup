import React, { useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  ImageBackground,
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  Image,
  View,
} from 'react-native';
import { supabase } from '../lib/supabase';

type InterfaceLanguage = 'te' | 'en';

const C = {
  purple: '#32165C',
  deep: '#24103F',
  gold: '#D8B66C',
  cream: '#FAF8F4',
  white: '#FFFFFF',
  muted: '#77717F',
  border: '#EAE3EE',
};

export default function AuthScreen() {
  const [language, setLanguage] = useState<InterfaceLanguage>('te');
  const [isLogin, setIsLogin] = useState(true);
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const telugu = language === 'te';

  const labels = telugu
    ? {
        heroKicker: 'WORSHIPVERSE • ఆరాధన',
        heroTitle: 'ప్రతి పాట ఒక ప్రార్థన.',
        heroLine: 'ప్రతి వాక్యం ఒక స్తుతి.',
        heroDescription: 'మీకు ఇష్టమైన ఆరాధన పాటలను సేవ్ చేసుకోండి.',
        welcome: 'తిరిగి స్వాగతం',
        register: 'ఖాతా సృష్టించండి',
        descriptionLogin: 'మీకు ఇష్టమైన పాటలు, ప్లేలిస్టుల కోసం సైన్ ఇన్ చేయండి.',
        descriptionRegister: 'మీ ఆరాధన ప్రయాణాన్ని ప్రారంభించండి.',
        name: 'పూర్తి పేరు',
        email: 'ఇమెయిల్ చిరునామా',
        password: 'పాస్‌వర్డ్',
        signIn: 'సైన్ ఇన్',
        signUp: 'ఖాతా సృష్టించండి',
        signingIn: 'దయచేసి వేచి ఉండండి...',
        switchToSignUp: 'ఖాతా లేదా?  రిజిస్టర్ అవ్వండి',
        switchToSignIn: 'ఇప్పటికే ఖాతా ఉందా?  సైన్ ఇన్',
        show: 'చూపు',
        hide: 'దాచు',
        footer: 'ప్రతి పాట ఒక ప్రార్థన • ప్రతి వాక్యం ఒక స్తుతి',
      }
    : {
        heroKicker: 'WORSHIPVERSE • WORSHIP SONGS',
        heroTitle: 'Every Song, A Prayer.',
        heroLine: 'Every Verse, A Praise.',
        heroDescription: 'Save the worship songs that stay close to your heart.',
        welcome: 'Welcome Back',
        register: 'Create Your Account',
        descriptionLogin: 'Sign in to access your favourites and playlists.',
        descriptionRegister: 'Begin your worship journey with us.',
        name: 'Full name',
        email: 'Email address',
        password: 'Password',
        signIn: 'Sign In',
        signUp: 'Create Account',
        signingIn: 'Please wait...',
        switchToSignUp: "Don't have an account?  Sign Up",
        switchToSignIn: 'Already have an account?  Sign In',
        show: 'Show',
        hide: 'Hide',
        footer: 'Every Song, A Prayer. Every Verse, A Praise.',
      };

  const handleAuth = async () => {
    const cleanEmail = email.trim().toLowerCase();
    if (!cleanEmail || !password) {
      Alert.alert('Required', telugu ? 'ఇమెయిల్ మరియు పాస్‌వర్డ్ నమోదు చేయండి.' : 'Please enter your email and password.');
      return;
    }
    if (!/^\S+@\S+\.\S+$/.test(cleanEmail)) {
      Alert.alert('Email', telugu ? 'సరైన ఇమెయిల్ చిరునామా నమోదు చేయండి.' : 'Enter a valid email address.');
      return;
    }
    if (!isLogin && !name.trim()) {
      Alert.alert('Required', telugu ? 'మీ పూర్తి పేరు నమోదు చేయండి.' : 'Please enter your name.');
      return;
    }
    if (!isLogin && password.length < 8) {
      Alert.alert('Password', telugu ? 'పాస్‌వర్డ్ కనీసం 8 అక్షరాలు ఉండాలి.' : 'Use at least 8 characters.');
      return;
    }

    setLoading(true);
    try {
      if (isLogin) {
        const { error } = await supabase.auth.signInWithPassword({
          email: cleanEmail,
          password,
        });
        if (error) throw error;
        setPassword('');
      } else {
        const { error } = await supabase.auth.signUp({
          email: cleanEmail,
          password,
          options: { data: { full_name: name.trim() } },
        });
        if (error) throw error;
        setPassword('');
        Alert.alert(
          telugu ? 'ఇమెయిల్ చూడండి' : 'Check your email',
          telugu
            ? 'ఖాతాను ధృవీకరించడానికి మీ ఇమెయిల్‌లోని లింక్‌ను తెరవండి.'
            : 'Please verify your email address to activate your account.',
        );
      }
    } catch (error: unknown) {
      const details = error instanceof Error ? error.message : 'Please try again.';
      Alert.alert(telugu ? 'లాగిన్ సమస్య' : 'Authentication failed', details);
    } finally {
      setLoading(false);
    }
  };

  function switchMode() {
    if (loading) return;
    setIsLogin((current) => !current);
    setPassword('');
    setShowPassword(false);
  }

  return (
    <KeyboardAvoidingView
      style={styles.root}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >
      <ScrollView
        style={styles.scroll}
        contentContainerStyle={styles.scrollContent}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.page}>
          <View style={styles.topBar}>
            <View style={styles.brandRow}>
              <View style={styles.brandMark}><Text style={styles.brandMarkText}>✝</Text></View>
              <Text style={styles.brand}>WorshipVerse</Text>
            </View>
            <View style={styles.languagePill}>
              <TouchableOpacity
                style={[styles.languageOption, telugu && styles.languageOptionActive]}
                onPress={() => setLanguage('te')}
                accessibilityRole="button"
                accessibilityLabel="తెలుగు"
              ><Text style={[styles.languageOptionText, telugu && styles.languageOptionTextActive]}>తె</Text></TouchableOpacity>
              <TouchableOpacity
                style={[styles.languageOption, !telugu && styles.languageOptionActive]}
                onPress={() => setLanguage('en')}
                accessibilityRole="button"
                accessibilityLabel="English"
              ><Text style={[styles.languageOptionText, !telugu && styles.languageOptionTextActive]}>EN</Text></TouchableOpacity>
            </View>
          </View>

          <ImageBackground
            source={require('../../assets/website/worshipverse-hero-artwork.png')}
            style={styles.hero}
            imageStyle={styles.heroImage}
            resizeMode="cover"
          >
            <View style={styles.heroOverlay}>
              <Text style={styles.heroKicker}>{labels.heroKicker}</Text>
              <Text style={styles.heroTitle}>{labels.heroTitle}</Text>
              <Text style={styles.heroLine}>{labels.heroLine}</Text>
              <View style={styles.goldLine} />
              <Text style={styles.heroDescription}>{labels.heroDescription}</Text>
            </View>
          </ImageBackground>

          <View style={styles.formArea}>
            <View style={styles.formCard}>
              <Text style={styles.formEyebrow}>WORSHIPVERSE ACCOUNT</Text>
              <Text style={styles.heading}>{isLogin ? labels.welcome : labels.register}</Text>
              <Text style={styles.formDescription}>
                {isLogin ? labels.descriptionLogin : labels.descriptionRegister}
              </Text>

              {!isLogin && (
                <View style={styles.field}>
                  <Text style={styles.fieldLabel}>{labels.name}</Text>
                  <TextInput
                    style={styles.input}
                    value={name}
                    onChangeText={setName}
                    placeholder={labels.name}
                    placeholderTextColor="#968D9F"
                    autoComplete="name"
                    maxLength={80}
                    editable={!loading}
                  />
                </View>
              )}

              <View style={styles.field}>
                <Text style={styles.fieldLabel}>{labels.email}</Text>
                <TextInput
                  style={styles.input}
                  value={email}
                  onChangeText={setEmail}
                  placeholder="name@example.com"
                  placeholderTextColor="#968D9F"
                  keyboardType="email-address"
                  autoCapitalize="none"
                  autoCorrect={false}
                  autoComplete="email"
                  editable={!loading}
                />
              </View>

              <View style={styles.field}>
                <Text style={styles.fieldLabel}>{labels.password}</Text>
                <View style={styles.passwordField}>
                  <TextInput
                    style={styles.passwordInput}
                    value={password}
                    onChangeText={setPassword}
                    placeholder={isLogin ? '••••••••' : 'Minimum 8 characters'}
                    placeholderTextColor="#968D9F"
                    secureTextEntry={!showPassword}
                    autoCapitalize="none"
                    autoCorrect={false}
                    autoComplete={isLogin ? 'current-password' : 'new-password'}
                    editable={!loading}
                  />
                  <TouchableOpacity
                    style={styles.showButton}
                    onPress={() => setShowPassword((value) => !value)}
                    accessibilityRole="button"
                    accessibilityLabel={showPassword ? labels.hide : labels.show}
                  >
                    <Text style={styles.showText}>{showPassword ? labels.hide : labels.show}</Text>
                  </TouchableOpacity>
                </View>
              </View>

              <TouchableOpacity
                onPress={handleAuth}
                disabled={loading}
                activeOpacity={0.85}
                style={[styles.submitButton, loading && styles.disabled]}
                accessibilityRole="button"
              >
                {loading ? (
                  <ActivityIndicator color={C.deep} />
                ) : (
                  <Text style={styles.submitText}>{isLogin ? labels.signIn : labels.signUp}  →</Text>
                )}
              </TouchableOpacity>

              <TouchableOpacity
                onPress={switchMode}
                disabled={loading}
                style={styles.switchButton}
                accessibilityRole="button"
              >
                <Text style={styles.switchText}>
                  {isLogin ? labels.switchToSignUp : labels.switchToSignIn}
                </Text>
              </TouchableOpacity>
            </View>
          </View>

          <View style={styles.footer}>
            <Text style={styles.footerBrand}>WorshipVerse</Text>
            <Text style={styles.footerLine}>{labels.footer}</Text>
            <Text style={styles.footerChurch}>SHARON A.G. CHURCH</Text>
          </View>
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
  root: { flex: 1, backgroundColor: C.cream },
  scroll: { flex: 1 },
  scrollContent: { flexGrow: 1, alignItems: 'center' },
  page: { width: '100%', maxWidth: 560, flexGrow: 1, backgroundColor: C.cream },
  topBar: {
    backgroundColor: C.deep,
    paddingHorizontal: 17,
    paddingTop: Platform.OS === 'ios' ? 55 : Platform.OS === 'android' ? 30 : 16,
    paddingBottom: 16,
    flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
  },
  brandRow: { flexDirection: 'row', alignItems: 'center', gap: 9 },
  brandMark: {
    width: 34, height: 34, borderRadius: 10, backgroundColor: C.gold,
    alignItems: 'center', justifyContent: 'center',
  },
  brandMarkText: { color: C.deep, fontSize: 20, fontWeight: '800' },
  brand: { color: C.white, fontSize: 18, fontWeight: '800' },
  languagePill: {
    flexDirection: 'row', padding: 3, borderRadius: 12,
    backgroundColor: 'rgba(255,255,255,0.13)', gap: 2,
  },
  languageOption: { paddingHorizontal: 11, paddingVertical: 8, borderRadius: 9 },
  languageOptionActive: { backgroundColor: C.gold },
  languageOptionText: { color: C.white, fontWeight: '800', fontSize: 11 },
  languageOptionTextActive: { color: C.deep },
  hero: { minHeight: 305, backgroundColor: C.deep },
  heroImage: { width: '100%' },
  heroOverlay: {
    flex: 1, justifyContent: 'flex-end', paddingHorizontal: 25,
    paddingTop: 36, paddingBottom: 59,
    backgroundColor: 'rgba(36, 16, 63, 0.57)',
  },
  heroKicker: { color: C.gold, fontSize: 10, fontWeight: '800', letterSpacing: 1.6 },
  heroTitle: { color: C.white, fontSize: 29, lineHeight: 39, fontWeight: '800', marginTop: 12 },
  heroLine: { color: '#F0D392', fontSize: 23, lineHeight: 35, fontWeight: '800', marginTop: 2 },
  goldLine: { width: 46, height: 3, backgroundColor: C.gold, marginTop: 18, borderRadius: 2 },
  heroDescription: { color: '#F9EAF8', fontSize: 12, lineHeight: 21, marginTop: 12, maxWidth: 290 },
  formArea: { paddingHorizontal: 16, marginTop: -28 },
  formCard: {
    paddingHorizontal: 22, paddingTop: 26, paddingBottom: 23,
    backgroundColor: C.white, borderRadius: 20,
    borderWidth: 1, borderColor: C.border,
    elevation: 4,
    shadowColor: C.deep, shadowOpacity: 0.12, shadowRadius: 10, shadowOffset: { width: 0, height: 4 },
  },
  formEyebrow: { color: '#A07A34', fontSize: 10, fontWeight: '800', letterSpacing: 1.4 },
  heading: { color: C.purple, fontSize: 25, fontWeight: '800', marginTop: 10 },
  formDescription: { color: C.muted, fontSize: 12, lineHeight: 20, marginTop: 7, marginBottom: 9 },
  field: { marginTop: 16 },
  fieldLabel: { color: C.deep, fontSize: 12, fontWeight: '700', marginBottom: 8 },
  input: {
    minHeight: 49, borderWidth: 1, borderColor: '#DFD5E7', borderRadius: 11,
    backgroundColor: '#FCFAFD', paddingHorizontal: 14, paddingVertical: 12,
    color: C.deep, fontSize: 14,
  },
  passwordField: {
    minHeight: 49, flexDirection: 'row', alignItems: 'center',
    borderWidth: 1, borderColor: '#DFD5E7', borderRadius: 11, backgroundColor: '#FCFAFD',
  },
  passwordInput: { flex: 1, minWidth: 0, paddingHorizontal: 14, paddingVertical: 12, color: C.deep, fontSize: 14 },
  showButton: { paddingHorizontal: 13, paddingVertical: 12 },
  showText: { color: C.purple, fontSize: 12, fontWeight: '800' },
  submitButton: {
    marginTop: 23, backgroundColor: C.gold, borderRadius: 12,
    minHeight: 52, paddingHorizontal: 18, paddingVertical: 14,
    alignItems: 'center', justifyContent: 'center',
  },
  disabled: { opacity: 0.65 },
  submitText: { color: C.deep, fontSize: 15, fontWeight: '800' },
  switchButton: { alignItems: 'center', paddingVertical: 16, marginTop: 5 },
  switchText: { color: C.purple, fontSize: 13, fontWeight: '700', textAlign: 'center' },
  footer: { alignItems: 'center', paddingHorizontal: 24, paddingTop: 29, paddingBottom: 35 },
  footerBrand: { color: C.purple, fontSize: 18, fontWeight: '800' },
  footerLine: { color: '#9B7A3C', fontSize: 11, textAlign: 'center', marginTop: 8 },
  footerChurch: { color: C.muted, fontSize: 10, letterSpacing: 1.2, marginTop: 12 },
});
