import React, { useRef, useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  Image,
  ImageBackground,
  Modal,
  Platform,
  ScrollView,
  StatusBar,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from 'react-native';
import type { Session } from '@supabase/supabase-js';
import { supabase } from '../lib/supabase';

type Language = 'te' | 'en';
type HomeScreenProps = { session: Session | null; onLogin: () => void };

// Keep the existing screen contracts unchanged.
const SongsScreen = require('./SongsScreen').default as React.ComponentType<{
  language: Language;
  onBack: () => void;
}>;
const ProfileScreen = require('./ProfileScreen').default as React.ComponentType<{
  onBack: () => void;
}>;
const FavouritesScreen = require('./FavouritesScreen').default as React.ComponentType<{
  onBack: () => void;
  onBrowseSongs: () => void;
}>;
const PlaylistsScreen = require('./PlaylistsScreen').default as React.ComponentType<{
  onBack: () => void;
}>;
const SettingsScreen = require('./SettingsScreen').default as React.ComponentType<{
  onBack: () => void;
}>;

const C = {
  purple: '#24103F',
  plum: '#32165C',
  gold: '#D8B66C',
  cream: '#FAF8F4',
  muted: '#766B80',
};

export default function HomeScreen({ session, onLogin }: HomeScreenProps) {
  // React Native 0.88 requires an instance ref, not useRef<ScrollView>.
  const scrollRef = useRef<React.ComponentRef<typeof ScrollView>>(null);
  const [language, setLanguage] = useState<Language>('te');
  const [songsLanguage, setSongsLanguage] = useState<Language | null>(null);
  const [screen, setScreen] = useState<'profile' | 'favourites' | 'playlists' | 'settings' | null>(null);
  const [accountOpen, setAccountOpen] = useState(false);
  const [loginPrompt, setLoginPrompt] = useState(false);
  const [signingOut, setSigningOut] = useState(false);
  const isTe = language === 'te';
  const email = session?.user.email ?? '';

  function protectedScreen(next: NonNullable<typeof screen>) {
    setAccountOpen(false);
    if (!session) {
      setLoginPrompt(true);
      return;
    }
    setScreen(next);
  }

  function startLogin() {
    setAccountOpen(false);
    setLoginPrompt(false);
    onLogin();
  }

  async function signOut() {
    setSigningOut(true);
    const { error } = await supabase.auth.signOut();
    setSigningOut(false);
    if (error) {
      Alert.alert(isTe ? 'లాగౌట్ విఫలమైంది' : 'Sign out failed', error.message);
      return;
    }
    setAccountOpen(false);
  }

  if (songsLanguage) {
    return <SongsScreen language={songsLanguage} onBack={() => setSongsLanguage(null)} />;
  }
  if (screen === 'profile') return <ProfileScreen onBack={() => setScreen(null)} />;
  if (screen === 'favourites') {
    return (
      <FavouritesScreen
        onBack={() => setScreen(null)}
        onBrowseSongs={() => {
          setScreen(null);
          setSongsLanguage('te');
        }}
      />
    );
  }
  if (screen === 'playlists') return <PlaylistsScreen onBack={() => setScreen(null)} />;
  if (screen === 'settings') return <SettingsScreen onBack={() => setScreen(null)} />;

  return (
    <View style={s.root}>
      <StatusBar barStyle="light-content" />

      {/* Compact website-inspired header */}
      <View style={s.header}>
        <TouchableOpacity
          style={s.brand}
          onPress={() => scrollRef.current?.scrollTo({ y: 0, animated: true })}
          accessibilityRole="button"
          accessibilityLabel="WorshipVerse home"
        >
          <Image source={require('../../assets/worshipverse-logo.png')} style={s.logo} />
          <View>
            <Text style={s.brandTitle}>WorshipVerse</Text>
            <Text style={s.brandSub}>SHARON A.G. CHURCH</Text>
          </View>
        </TouchableOpacity>
        <View style={s.headerRight}>
          <TouchableOpacity style={s.languageButton} onPress={() => setLanguage(isTe ? 'en' : 'te')}>
            <Text style={s.languageText}>{isTe ? 'English' : 'తెలుగు'}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={s.avatar} onPress={() => setAccountOpen(true)} accessibilityLabel="Account menu">
            <Text style={s.avatarText}>{email ? email[0].toUpperCase() : '☻'}</Text>
          </TouchableOpacity>
        </View>
      </View>

      <ScrollView
        ref={scrollRef}
        showsVerticalScrollIndicator={false}
        contentContainerStyle={s.scrollContent}
      >
        {/* Stage background + sunrise cross artwork from the website */}
        <ImageBackground
          source={require('../../assets/website/worship-background.jpg')}
          imageStyle={s.roundImage}
          style={s.hero}
          resizeMode="cover"
        >
          <View style={s.heroOverlay}>
            <Text style={s.eyebrow}>{isTe ? '✦ ఆరాధన • స్తుతి • గీతాలు' : '✦ WORSHIP • PRAISE • SONGS'}</Text>
            <Text style={s.heroTitle}>{isTe ? 'ప్రతి పాట ఒక ప్రార్థన.' : 'Every Song, A Prayer.'}</Text>
            <Text style={s.heroGold}>{isTe ? 'ప్రతి వాక్యం ఒక స్తుతి.' : 'Every Verse, A Praise.'}</Text>
            <Text style={s.heroDesc}>
              {isTe
                ? 'తెలుగు మరియు ఆంగ్ల క్రైస్తవ ఆరాధన గీతాలు ఒకే చోట.'
                : 'Discover Telugu and English Christian worship songs in one place.'}
            </Text>
            <TouchableOpacity style={s.primaryButton} onPress={() => setSongsLanguage('te')}>
              <Text style={s.primaryButtonText}>{isTe ? 'పాటలను అన్వేషించండి  →' : 'Explore Songs  →'}</Text>
            </TouchableOpacity>
            {/* Uploaded website hero artwork: sunrise cross. */}
            <Image
              source={require('../../assets/website/worshipverse-hero-artwork.png')}
              style={s.heroArtwork}
              resizeMode="cover"
              accessibilityLabel="Cross at sunrise"
            />
          </View>
        </ImageBackground>

        <View style={s.quickRow}>
          <View style={s.quickPill}><Text style={s.quickText}>♫ Telugu Worship</Text></View>
          <View style={s.quickPill}><Text style={s.quickText}>♫ English Worship</Text></View>
        </View>

        <View style={s.sectionHeader}>
          <Text style={s.sectionKicker}>{isTe ? 'భాషలు' : 'LANGUAGES'}</Text>
          <Text style={s.sectionTitle}>{isTe ? 'మీ భాషలో పాటలు' : 'Songs in your language'}</Text>
          <Text style={s.sectionSubtitle}>
            {isTe ? 'మీకు ఇష్టమైన ఆరాధన గీతాలను కనుగొనండి.' : 'Browse the worship collection.'}
          </Text>
        </View>

        <View style={s.languageGrid}>
          <TouchableOpacity style={s.collectionCard} activeOpacity={0.9} onPress={() => setSongsLanguage('te')}>
            <ImageBackground
              source={require('../../assets/website/telugu-worship.jpg')}
              style={s.collectionImage}
              imageStyle={s.collectionImageRadius}
            >
              <View style={s.collectionOverlay}>
                <Text style={s.collectionKicker}>TELUGU COLLECTION</Text>
                <Text style={s.collectionTitle}>తెలుగు పాటలు</Text>
                <Text style={s.collectionLink}>{isTe ? 'పాటలు చూడండి →' : 'Explore →'}</Text>
              </View>
            </ImageBackground>
          </TouchableOpacity>
          <TouchableOpacity style={s.collectionCard} activeOpacity={0.9} onPress={() => setSongsLanguage('en')}>
            <ImageBackground
              source={require('../../assets/website/english-worship.jpg')}
              style={s.collectionImage}
              imageStyle={s.collectionImageRadius}
            >
              <View style={s.collectionOverlay}>
                <Text style={s.collectionKicker}>ENGLISH COLLECTION</Text>
                <Text style={s.collectionTitle}>English Songs</Text>
                <Text style={s.collectionLink}>{isTe ? 'పాటలు చూడండి →' : 'Explore →'}</Text>
              </View>
            </ImageBackground>
          </TouchableOpacity>
        </View>

        <View style={s.sectionHeader}>
          <Text style={s.sectionKicker}>{isTe ? 'ప్రత్యేకతలు' : 'FEATURES'}</Text>
          <Text style={s.sectionTitle}>{isTe ? 'ఆరాధన మరింత సులభం' : 'Worship, made simple'}</Text>
        </View>
        <View style={s.featuresGrid}>
          <TouchableOpacity style={s.featureCard} onPress={() => setSongsLanguage('te')}>
            <Text style={s.featureIcon}>♫</Text>
            <Text style={s.featureTitle}>{isTe ? 'ఆరాధన గీతాలు' : 'Worship Songs'}</Text>
            <Text style={s.featureDesc}>{isTe ? 'తెలుగు, ఆంగ్ల పాటలు' : 'Telugu & English lyrics'}</Text>
          </TouchableOpacity>
          <View style={s.featureCard}>
            <Text style={s.featureIcon}>↓</Text>
            <Text style={s.featureTitle}>{isTe ? 'ఆఫ్‌లైన్' : 'Offline Library'}</Text>
            <Text style={s.featureDesc}>{isTe ? 'సేవ్ చేసిన పాటలు' : 'Saved lyrics on device'}</Text>
          </View>
          <TouchableOpacity style={s.featureCard} onPress={() => protectedScreen('favourites')}>
            <Text style={s.featureIcon}>♡</Text>
            <Text style={s.featureTitle}>{isTe ? 'ఇష్టమైన పాటలు' : 'Favourites'}</Text>
            <Text style={s.featureDesc}>{isTe ? 'మీ పాటలను సేవ్ చేయండి' : 'Keep songs close'}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={s.featureCard} onPress={() => protectedScreen('playlists')}>
            <Text style={s.featureIcon}>☷</Text>
            <Text style={s.featureTitle}>{isTe ? 'ప్లేలిస్టులు' : 'Playlists'}</Text>
            <Text style={s.featureDesc}>{isTe ? 'మీ జాబితాలను సృష్టించండి' : 'Organise your songs'}</Text>
          </TouchableOpacity>
        </View>

        <ImageBackground
          source={require('../../assets/website/worship-background.jpg')}
          imageStyle={s.roundImage}
          style={s.churchCard}
        >
          <View style={s.churchOverlay}>
            <Text style={s.churchKicker}>SHARON A.G. CHURCH</Text>
            <Text style={s.churchTitle}>{isTe ? 'ఆరాధనలో మాతో చేరండి' : 'Join Us in Worship'}</Text>
            <Text style={s.churchDesc}>
              {isTe ? 'ప్రతి పాట ఒక ప్రార్థన. ప్రతి వాక్యం ఒక స్తుతి.' : 'Every song, a prayer. Every verse, a praise.'}
            </Text>
            <TouchableOpacity style={s.outlineButton} onPress={() => setSongsLanguage('te')}>
              <Text style={s.outlineButtonText}>{isTe ? 'ఇప్పుడే ప్రారంభించండి →' : 'Get Started →'}</Text>
            </TouchableOpacity>
          </View>
        </ImageBackground>
        <Text style={s.footer}>© 2026 WorshipVerse · SHARON A.G. CHURCH</Text>
      </ScrollView>

      {/* Compact bottom navigation */}
      <View style={s.bottomNav}>
        <TouchableOpacity style={s.navItem} onPress={() => scrollRef.current?.scrollTo({ y: 0, animated: true })}>
          <Text style={s.navIcon}>⌂</Text><Text style={s.navLabel}>{isTe ? 'హోమ్' : 'Home'}</Text>
        </TouchableOpacity>
        <TouchableOpacity style={s.navItem} onPress={() => setSongsLanguage('te')}>
          <Text style={s.navIcon}>♫</Text><Text style={s.navLabel}>తెలుగు</Text>
        </TouchableOpacity>
        <TouchableOpacity style={s.navItem} onPress={() => setSongsLanguage('en')}>
          <Text style={s.navIcon}>♫</Text><Text style={s.navLabel}>English</Text>
        </TouchableOpacity>
        <TouchableOpacity style={s.navItem} onPress={() => protectedScreen('favourites')}>
          <Text style={s.navIcon}>♡</Text><Text style={s.navLabel}>{isTe ? 'ఇష్టాలు' : 'Saved'}</Text>
        </TouchableOpacity>
        <TouchableOpacity style={s.navItem} onPress={() => protectedScreen('playlists')}>
          <Text style={s.navIcon}>☷</Text><Text style={s.navLabel}>{isTe ? 'జాబితాలు' : 'Lists'}</Text>
        </TouchableOpacity>
      </View>

      {/* Account menu */}
      <Modal visible={accountOpen} transparent animationType="fade" onRequestClose={() => setAccountOpen(false)}>
        <View style={s.modalBackdrop}>
          <View style={s.modalCard}>
            <Text style={s.modalTitle}>{isTe ? 'నా ఖాతా' : 'My Account'}</Text>
            <Text style={s.modalEmail}>{email || (isTe ? 'అతిథి' : 'Guest')}</Text>
            <TouchableOpacity style={s.modalOption} onPress={() => protectedScreen('profile')}>
              <Text style={s.modalOptionText}>{isTe ? 'నా ప్రొఫైల్' : 'My Profile'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={s.modalOption} onPress={() => protectedScreen('favourites')}>
              <Text style={s.modalOptionText}>{isTe ? 'ఇష్టమైన పాటలు' : 'My Favourites'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={s.modalOption} onPress={() => protectedScreen('playlists')}>
              <Text style={s.modalOptionText}>{isTe ? 'నా ప్లేలిస్టులు' : 'My Playlists'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={s.modalOption} onPress={() => protectedScreen('settings')}>
              <Text style={s.modalOptionText}>{isTe ? 'సెట్టింగ్స్' : 'Settings'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={s.modalOption} onPress={() => setAccountOpen(false)}>
              <Text style={s.modalOptionText}>{isTe ? 'మూసివేయి' : 'Close'}</Text>
            </TouchableOpacity>
            <TouchableOpacity
              style={s.modalAction}
              disabled={signingOut}
              onPress={session ? signOut : startLogin}
            >
              {signingOut ? <ActivityIndicator color="#FFFFFF" /> : (
                <Text style={s.modalActionText}>{session ? (isTe ? 'లాగౌట్' : 'Sign Out') : (isTe ? 'లాగిన్ / నమోదు' : 'Sign In / Sign Up')}</Text>
              )}
            </TouchableOpacity>
          </View>
        </View>
      </Modal>

      {/* Guest sign-in prompt, including on Expo Web */}
      <Modal visible={loginPrompt} transparent animationType="fade" onRequestClose={() => setLoginPrompt(false)}>
        <View style={s.modalBackdrop}>
          <View style={s.modalCard}>
            <Text style={s.modalTitle}>{isTe ? 'లాగిన్ అవసరం' : 'Sign in required'}</Text>
            <Text style={s.promptText}>
              {isTe
                ? 'ఇష్టమైన పాటలు, ప్లేలిస్టులు, ఖాతా వివరాల కోసం లాగిన్ చేయండి.'
                : 'Sign in to use favourites, playlists and account features.'}
            </Text>
            <TouchableOpacity style={s.modalAction} onPress={startLogin}>
              <Text style={s.modalActionText}>{isTe ? 'లాగిన్ చేయండి' : 'Sign In'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={s.modalOption} onPress={() => setLoginPrompt(false)}>
              <Text style={s.modalOptionText}>{isTe ? 'రద్దు' : 'Cancel'}</Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    </View>
  );
}

const s = StyleSheet.create({
  root: { flex: 1, backgroundColor: C.cream },
  header: { backgroundColor: C.purple, paddingHorizontal: 14, paddingTop: Platform.OS === 'ios' ? 45 : 13, paddingBottom: 12, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },
  brand: { flexDirection: 'row', alignItems: 'center', flexShrink: 1 },
  logo: { width: 39, height: 39, borderRadius: 9, marginRight: 8 },
  brandTitle: { fontSize: 17, color: '#FFFFFF', fontWeight: '800' },
  brandSub: { fontSize: 8, color: C.gold, letterSpacing: 1.1, marginTop: 2 },
  headerRight: { flexDirection: 'row', alignItems: 'center', gap: 8 },
  languageButton: { borderWidth: 1, borderColor: C.gold, borderRadius: 20, paddingVertical: 8, paddingHorizontal: 10 },
  languageText: { color: C.gold, fontSize: 11, fontWeight: '700' },
  avatar: { width: 33, height: 33, backgroundColor: C.gold, borderRadius: 17, alignItems: 'center', justifyContent: 'center' },
  avatarText: { color: C.purple, fontWeight: '800', fontSize: 15 },
  scrollContent: { paddingHorizontal: 14, paddingBottom: 25 },
  roundImage: { borderRadius: 19 },
  hero: { minHeight: 260, marginTop: 13, borderRadius: 19, overflow: 'hidden' },
  heroOverlay: { flex: 1, padding: 20, justifyContent: 'center', backgroundColor: 'rgba(30,10,55,0.47)' },
  heroArtwork: { width: '100%', height: 112, borderRadius: 13, marginTop: 16 },
  eyebrow: { color: C.gold, fontSize: 10, fontWeight: '800', letterSpacing: 1, marginBottom: 13 },
  heroTitle: { color: '#FFFFFF', fontSize: 25, lineHeight: 34, fontWeight: '800' },
  heroGold: { color: C.gold, fontSize: 21, lineHeight: 30, fontWeight: '800', marginTop: 3 },
  heroDesc: { color: '#F2EAFB', fontSize: 12, lineHeight: 20, marginTop: 12, maxWidth: 315 },
  primaryButton: { backgroundColor: C.gold, alignSelf: 'flex-start', borderRadius: 11, paddingHorizontal: 16, paddingVertical: 11, marginTop: 17 },
  primaryButtonText: { color: C.purple, fontWeight: '800', fontSize: 12 },
  quickRow: { flexDirection: 'row', gap: 8, marginTop: 13 },
  quickPill: { backgroundColor: '#EFE8F6', flex: 1, borderRadius: 12, paddingVertical: 10, alignItems: 'center' },
  quickText: { color: C.plum, fontSize: 10, fontWeight: '700' },
  sectionHeader: { marginTop: 26, marginBottom: 12 },
  sectionKicker: { color: '#98743F', fontWeight: '800', fontSize: 10, letterSpacing: 1.3 },
  sectionTitle: { color: C.plum, fontSize: 21, fontWeight: '800', marginTop: 6 },
  sectionSubtitle: { color: C.muted, fontSize: 12, marginTop: 5 },
  languageGrid: { flexDirection: 'row', gap: 10 },
  collectionCard: { flex: 1, minWidth: 0 },
  collectionImage: { height: 155, justifyContent: 'flex-end', overflow: 'hidden', borderRadius: 16 },
  collectionImageRadius: { borderRadius: 16 },
  collectionOverlay: { flex: 1, padding: 13, justifyContent: 'flex-end', backgroundColor: 'rgba(31,12,55,0.35)', borderRadius: 16 },
  collectionKicker: { color: C.gold, fontSize: 8, fontWeight: '800', letterSpacing: 0.4 },
  collectionTitle: { color: '#FFFFFF', fontSize: 19, fontWeight: '800', marginTop: 6 },
  collectionLink: { color: '#F2DDAA', fontSize: 10, fontWeight: '700', marginTop: 11 },
  featuresGrid: { flexDirection: 'row', flexWrap: 'wrap', gap: 10 },
  featureCard: { backgroundColor: '#FFFFFF', borderRadius: 15, padding: 14, width: '48%', flexGrow: 1, borderWidth: 1, borderColor: '#EEE6F1' },
  featureIcon: { color: C.plum, fontSize: 25, marginBottom: 8 },
  featureTitle: { color: C.plum, fontSize: 13, fontWeight: '800' },
  featureDesc: { color: C.muted, fontSize: 10, lineHeight: 15, marginTop: 5 },
  churchCard: { marginTop: 26, minHeight: 190, borderRadius: 19, overflow: 'hidden' },
  churchOverlay: { backgroundColor: 'rgba(36,16,63,0.48)', flex: 1, padding: 22, justifyContent: 'center', alignItems: 'center' },
  churchKicker: { color: C.gold, fontSize: 9, fontWeight: '800', letterSpacing: 1.5 },
  churchTitle: { color: '#FFFFFF', fontWeight: '800', fontSize: 20, textAlign: 'center', marginTop: 9 },
  churchDesc: { color: '#EAE0F3', fontSize: 11, textAlign: 'center', marginTop: 8 },
  outlineButton: { borderColor: C.gold, borderWidth: 1, borderRadius: 10, marginTop: 14, paddingVertical: 10, paddingHorizontal: 15 },
  outlineButtonText: { color: C.gold, fontSize: 11, fontWeight: '800' },
  footer: { color: C.muted, fontSize: 9, textAlign: 'center', marginTop: 22 },
  bottomNav: { backgroundColor: C.purple, flexDirection: 'row', borderTopColor: '#D8B66C55', borderTopWidth: 1, paddingTop: 7, paddingBottom: Platform.OS === 'ios' ? 18 : 9 },
  navItem: { flex: 1, alignItems: 'center', justifyContent: 'center' },
  navIcon: { color: C.gold, fontSize: 21 },
  navLabel: { color: '#FFFFFF', fontWeight: '600', fontSize: 9, marginTop: 3 },
  modalBackdrop: { flex: 1, backgroundColor: '#00000099', justifyContent: 'center', padding: 22 },
  modalCard: { backgroundColor: '#FFFFFF', padding: 22, borderRadius: 20 },
  modalTitle: { fontSize: 20, fontWeight: '800', color: C.plum },
  modalEmail: { color: C.muted, marginTop: 8, marginBottom: 13, fontSize: 12 },
  modalOption: { paddingVertical: 12, borderBottomWidth: 1, borderBottomColor: '#EEE8F0' },
  modalOptionText: { color: C.plum, fontSize: 14, fontWeight: '700' },
  modalAction: { backgroundColor: C.plum, borderRadius: 12, paddingVertical: 13, alignItems: 'center', marginTop: 15 },
  modalActionText: { color: '#FFFFFF', fontWeight: '800', fontSize: 13 },
  promptText: { color: C.muted, fontSize: 13, lineHeight: 21, marginTop: 12 },
});
