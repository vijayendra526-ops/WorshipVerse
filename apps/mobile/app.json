{
  "expo": {
    "name": "WorshipVerse",
    "slug": "worshipverse",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow WorshipVerse to recognize your voice when searching for songs.",
        "NSMicrophoneUsageDescription": "Allow WorshipVerse to use your microphone for song voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "in.sharonag.worshipverse"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow WorshipVerse to use your microphone for song voice search.",
          "speechRecognitionPermission": "Allow WorshipVerse to recognize your voice when searching for songs.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "d16e77a9-a705-423c-89e4-60031922298e"
      }
    }
  }
}
